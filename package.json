  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
